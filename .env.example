# Add required environment variables here as they are discovered during planning and implementation.
# Never put real values in this file — it is committed to version control.
# Copy to .env and fill in real values locally.

# Database (SQLite — local file)
DATABASE_URL="file:./prisma/dev.db"

# Claude API — used for benefit parsing (Haiku model only)
ANTHROPIC_API_KEY=your_key_here

# NextAuth
NEXTAUTH_SECRET=your_secret_here
NEXTAUTH_URL=http://localhost:3002

# Admin credentials (single-user MVP — no User table in DB)
ADMIN_EMAIL=your_email@example.com
# Plain password — this is a local-only app, bcrypt hashes are incompatible with dotenv-expand
ADMIN_PASSWORD=your_password_here
ADMIN_USER_ID=user_swarnim
